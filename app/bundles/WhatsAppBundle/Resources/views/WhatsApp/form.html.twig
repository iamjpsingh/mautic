{% extends '@MauticCore/FormTheme/form_simple.html.twig' %}

{% block mauticContent %}whatsapp{% endblock %}
{# @var message \Mautic\WhatsAppBundle\Entity\WhatsAppMessage #}
{% set whatsapp        = message|default(null) %}
{% set messageType     = whatsapp ? whatsapp.getMessageType() : 'template' %}
{% set isExisting      = whatsapp ? whatsapp.getId() : false %}
{% set translationBase = 'mautic.whatsapp' %}
{% set mauticContent   = 'whatsapp' %}

{% block primaryFormContent %}
  <!-- Template Message Section -->
  <div id="whatsapp-template-section"{% if messageType != 'template' %} class="hide"{% endif %}>
    <h4><i class="ri-message-2-line"></i> {{ 'mautic.whatsapp.template.section.title'|trans }}</h4>
    <div class="row">
      <div class="col-md-8">
        {{ form_row(form.templateId) }}
      </div>
      <div class="col-md-4">
        <a href="{{ path('mautic_whatsapp_templates') }}" class="btn btn-default btn-block" style="margin-top:25px">
          <i class="ri-refresh-line"></i> {{ 'mautic.whatsapp.templates.menu'|trans }}
        </a>
      </div>
    </div>

    <!-- Template Preview Panel -->
    <div id="whatsapp-template-preview-panel" class="panel panel-default hide" style="margin-top:15px">
      <div class="panel-heading">
        <h5 class="panel-title">Template Preview</h5>
        <span id="preview-category-badge" class="label label-default pull-right"></span>
      </div>
      <div class="panel-body">
        <div id="preview-header" class="hide"><strong>Header:</strong> <span id="preview-header-text"></span><hr></div>
        <div id="preview-body"><strong>Body:</strong><div id="preview-body-text" class="well well-sm" style="white-space:pre-wrap"></div></div>
        <div id="preview-footer" class="hide"><strong>Footer:</strong> <span id="preview-footer-text" class="text-muted"></span></div>
        <div id="preview-buttons" class="hide"><strong>Buttons:</strong> <div id="preview-buttons-list"></div></div>
      </div>
    </div>

    <!-- Placeholder Mapping Section -->
    <div id="whatsapp-placeholder-mapping" class="hide" style="margin-top:15px">
      <h5><i class="ri-link"></i> Parameter Mapping</h5>
      <p class="text-muted small">Map template parameters to contact fields. Values will be filled automatically when sending.</p>
      <div id="placeholder-mapping-rows"></div>
    </div>

    <div class="hide">
      {{ form_row(form.templateName) }}
      {{ form_row(form.templateLanguage) }}
      {{ form_row(form.templateComponents) }}
    </div>
  </div>

  <!-- Session Message Section (hidden by default) -->
  <div id="whatsapp-session-section"{% if messageType != 'session' %} class="hide"{% endif %}>
    <h4><i class="ri-chat-1-line"></i> {{ 'mautic.whatsapp.session.section.title'|trans }}</h4>
    <div class="row">
      <div class="col-md-12">
        <div class="characters-count pull-right">
          <label class="control-label" for="" data-toggle="tooltip" data-container="body" data-placement="top" title="" data-original-title="{{ 'mautic.whatsapp.form.nbcharacter.infobox'|trans }}">
            {{ 'mautic.whatsapp.form.nbcharacter.counter'|trans }}
            <span size="sm" class="label label-gray" id="whatsapp_nb_char">0</span>
            <span class="text-muted small">/ 4096</span>
          </label>
        </div>
        {{ form_row(form.message) }}
        <i class="text-secondary">{{ 'mautic.whatsapp.token.dropdown.hint'|trans|purify }}</i>
      </div>
    </div>
  </div>

  <!-- Media Message Section (hidden by default) -->
  <div id="whatsapp-media-section"{% if messageType != 'media' %} class="hide"{% endif %}>
    <h4><i class="ri-image-line"></i> {{ 'mautic.whatsapp.media.section.title'|trans }}</h4>
    <div class="row">
      <div class="col-md-6">{{ form_row(form.mediaType) }}</div>
      <div class="col-md-6">{{ form_row(form.mediaUrl) }}</div>
    </div>
  </div>

  <!-- Interactive Message Section (hidden by default) -->
  <div id="whatsapp-interactive-section"{% if messageType != 'interactive' %} class="hide"{% endif %}>
    <h4><i class="ri-list-check"></i> {{ 'mautic.whatsapp.interactive.section.title'|trans }}</h4>
    <div class="row">
      <div class="col-md-6">{{ form_row(form.interactiveType) }}</div>
      <div class="col-md-6">{{ form_row(form.interactiveData) }}</div>
    </div>
  </div>
{% endblock %}

{% block rightFormContent %}
  {{ form_row(form.name) }}
  {{ form_row(form.messageType) }}
  {{ form_row(form.category) }}
  {{ form_row(form.isPublished, {
    'attr': {
      'data-none': 'mautic.core.form.sending_paused',
      'data-start': 'mautic.core.form.sending_on_scheduled_start',
      'data-both': 'mautic.core.form.sending_during_scheduled_period',
      'data-end': 'mautic.core.form.available_until_scheduled_end'
    }
  }) }}
  {{ form_row(form.publishUp) }}
  {{ form_row(form.publishDown) }}
  <div id="leadList">
    {{ form_row(form.lists) }}
  </div>
  <div class="hide">{{ form_rest(form) }}</div>
{% endblock %}
