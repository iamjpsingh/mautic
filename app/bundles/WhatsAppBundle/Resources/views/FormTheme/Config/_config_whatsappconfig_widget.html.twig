{% block _config_whatsappconfig_widget %}
<h4 class="fw-sb mt-48 mb-xs">{{ 'mautic.config.tab.whatsappconfig'|trans }}</h4>
<div class="text-muted small pb-md">{{ 'mautic.core.config.header.whatsappconfig.description'|trans }}</div>
<div class="row">
    <div class="panel panel-default mb-md">
        <div class="panel-body">
            <div class="row">
                <div class="col-xs-12">
                    {{ form_row(form.whatsapp_enabled) }}
                </div>
            </div>
            <hr>
            <div class="row">
                <div class="col-md-6">
                    {{ form_row(form.whatsapp_phone_number_id) }}
                </div>
                <div class="col-md-6">
                    {{ form_row(form.whatsapp_business_account_id) }}
                </div>
            </div>
            <div class="row">
                <div class="col-md-6">
                    {{ form_row(form.whatsapp_access_token) }}
                </div>
                <div class="col-md-6">
                    {{ form_row(form.whatsapp_app_secret) }}
                </div>
            </div>
            <div class="row">
                <div class="col-md-6">
                    {{ form_row(form.whatsapp_webhook_verify_token) }}
                </div>
            </div>
            <hr>
            <div class="row">
                <div class="col-xs-12">
                    {% if form.whatsapp_transport.vars.choices|length %}
                        {{ form_row(form.whatsapp_transport) }}
                    {% else %}
                        {{ 'mautic.whatsapp.config.no_transport'|trans }}
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>
<hr>
<div class="row">
  <div class="col-md-12">
    <h4>Webhook Status</h4>
    {% set webhookConfigured = form.whatsapp_webhook_verify_token.vars.value is not empty %}
    {% set whatsappEnabled = form.whatsapp_enabled.vars.value %}

    {% if whatsappEnabled and webhookConfigured %}
      <div class="alert alert-success">
        <i class="ri-checkbox-circle-line"></i> <strong>Webhook Configured</strong>
        — Ready to receive delivery status and incoming messages
      </div>
    {% elseif whatsappEnabled and not webhookConfigured %}
      <div class="alert alert-warning">
        <i class="ri-error-warning-line"></i> <strong>Webhook Not Configured</strong>
        — Set a verify token above and configure the webhook URL in Meta Dashboard
      </div>
    {% else %}
      <div class="alert alert-info">
        <i class="ri-information-line"></i> Enable WhatsApp above to configure webhooks
      </div>
    {% endif %}

    <div class="well">
      <p><strong>Webhook URL:</strong></p>
      <code style="display:block;padding:10px;background:#f5f5f5;border-radius:4px;margin-bottom:10px">
        {{ app.request.schemeAndHttpHost }}/whatsapp/meta_cloud/callback
      </code>
      <p><strong>Verify Token:</strong> <code>{{ form.whatsapp_webhook_verify_token.vars.value|default('Not set') }}</code></p>
      <p class="text-muted small" style="margin-top:10px">
        <i class="ri-external-link-line"></i>
        Configure this URL in your <a href="https://developers.facebook.com/apps" target="_blank">Meta Developer Dashboard</a> &rarr; WhatsApp &rarr; Configuration &rarr; Webhook
      </p>
      <p class="text-muted small">
        Subscribe to: <strong>messages</strong>, <strong>message_template_status_update</strong>, <strong>message_template_quality_update</strong>
      </p>
    </div>
  </div>
</div>
{% endblock %}
