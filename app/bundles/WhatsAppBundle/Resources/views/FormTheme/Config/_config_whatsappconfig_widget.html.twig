{% block _config_whatsappconfig_widget %}
<h4 class="fw-sb mt-48 mb-xs">{{ 'mautic.config.tab.whatsappconfig'|trans }}</h4>
<div class="text-muted small pb-md">{{ 'mautic.core.config.header.whatsappconfig.description'|trans }}</div>
<div class="row">
    <div class="panel panel-default mb-md">
        <div class="panel-body">
            <div class="row">
                <div class="col-xs-12">
                    {{ form_row(form.whatsapp_enabled) }}
                </div>
            </div>
            <hr>
            <div class="row">
                <div class="col-md-6">
                    {{ form_row(form.whatsapp_phone_number_id) }}
                </div>
                <div class="col-md-6">
                    {{ form_row(form.whatsapp_business_account_id) }}
                </div>
            </div>
            <div class="row">
                <div class="col-md-6">
                    {{ form_row(form.whatsapp_access_token) }}
                </div>
                <div class="col-md-6">
                    {{ form_row(form.whatsapp_app_secret) }}
                </div>
            </div>
            <div class="row">
                <div class="col-md-6">
                    {{ form_row(form.whatsapp_webhook_verify_token) }}
                </div>
                <div class="col-md-6" style="padding-top:25px;">
                    <button type="button" class="btn btn-default" onclick="var t=document.getElementById('config_whatsappconfig_whatsapp_webhook_verify_token');if(t){t.value='mautic_wa_'+Math.random().toString(36).substring(2,15);}">
                        <i class="ri-key-2-line"></i> {{ 'mautic.whatsapp.config.generate_token'|trans }}
                    </button>
                </div>
            </div>
            <hr>
            <div class="row">
                <div class="col-xs-12">
                    {% if form.whatsapp_transport.vars.choices|length %}
                        {{ form_row(form.whatsapp_transport) }}
                    {% else %}
                        {{ 'mautic.whatsapp.config.no_transport'|trans }}
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>
<hr>
<div class="row">
  <div class="col-md-12">
    <h4 class="fw-sb">{{ 'mautic.whatsapp.config.webhook.status'|trans }}</h4>

    {% set webhookState = form.vars.webhook_state|default({
      'status': 'not_configured',
      'last_verified_at': null,
      'last_received_at': null,
      'last_error': null,
      'last_error_at': null,
      'verify_count': 0,
      'receive_count': 0,
    }) %}

    <div id="whatsapp-webhook-status-panel">
      {% if webhookState.status == 'active' %}
        <div class="alert alert-success">
          <i class="ri-checkbox-circle-line"></i>
          <strong>{{ 'mautic.whatsapp.config.webhook.state.active'|trans }}</strong>
          — {{ 'mautic.whatsapp.config.webhook.state.active.desc'|trans }}
        </div>
      {% elseif webhookState.status == 'idle' %}
        <div class="alert alert-warning">
          <i class="ri-time-line"></i>
          <strong>{{ 'mautic.whatsapp.config.webhook.state.idle'|trans }}</strong>
          — {{ 'mautic.whatsapp.config.webhook.state.idle.desc'|trans }}
        </div>
      {% elseif webhookState.status == 'pending' %}
        <div class="alert alert-warning">
          <i class="ri-error-warning-line"></i>
          <strong>{{ 'mautic.whatsapp.config.webhook.state.pending'|trans }}</strong>
          — {{ 'mautic.whatsapp.config.webhook.state.pending.desc'|trans }}
        </div>
      {% elseif webhookState.status == 'error' %}
        <div class="alert alert-danger">
          <i class="ri-close-circle-line"></i>
          <strong>{{ 'mautic.whatsapp.config.webhook.state.broken'|trans }}</strong>
          — {{ webhookState.last_error|default('Webhook is not responding correctly') }}
        </div>
      {% else %}
        <div class="alert alert-danger">
          <i class="ri-close-circle-line"></i>
          <strong>{{ 'mautic.whatsapp.config.webhook.state.not_configured'|trans }}</strong>
          — {{ 'mautic.whatsapp.config.webhook.state.not_configured.desc'|trans }}
        </div>
      {% endif %}
    </div>

    {% set webhookPublicUrl    = form.vars.webhook_public_url|default('') %}
    {% set webhookPublicUrlSet = form.vars.webhook_public_url_set|default(false) %}
    {% set webhookBaseUrl      = webhookPublicUrlSet ? webhookPublicUrl|trim('/') : (app.request.schemeAndHttpHost) %}
    {% set webhookFullUrl      = webhookBaseUrl ~ '/whatsapp/meta_cloud/callback' %}

    {% if not webhookPublicUrlSet %}
      <div class="alert alert-warning">
        <i class="ri-error-warning-line"></i>
        <strong>{{ 'mautic.whatsapp.config.webhook.site_url_missing'|trans }}</strong>
        {{ 'mautic.whatsapp.config.webhook.site_url_missing.desc'|trans|raw }}
      </div>
    {% endif %}

    <div class="well">
      <div class="row">
        <div class="col-md-6">
          <p><strong>{{ 'mautic.whatsapp.config.webhook.url'|trans }}:</strong></p>
          <code style="display:block;padding:10px;background:#f5f5f5;border-radius:4px;margin-bottom:10px;word-break:break-all;">
            {{ webhookFullUrl }}
          </code>
          {% if not webhookPublicUrlSet %}
            <p class="text-warning small">
              <i class="ri-error-warning-line"></i>
              {{ 'mautic.whatsapp.config.webhook.url_from_request_warning'|trans }}
            </p>
          {% endif %}
          <p><strong>{{ 'mautic.whatsapp.config.form.webhook_verify_token'|trans }}:</strong>
            <code>{{ form.whatsapp_webhook_verify_token.vars.value|default('— ' ~ 'mautic.whatsapp.config.webhook.not_set'|trans ~ ' —') }}</code>
          </p>
        </div>
        <div class="col-md-6">
          <p><strong>{{ 'mautic.whatsapp.config.webhook.diagnostics'|trans }}:</strong></p>
          <table class="table table-condensed mb-0" style="background:transparent;">
            <tbody>
              <tr>
                <td class="text-muted">{{ 'mautic.whatsapp.config.webhook.last_verified'|trans }}</td>
                <td>
                  {% if webhookState.last_verified_at %}
                    <span class="text-success"><i class="ri-check-line"></i> {{ webhookState.last_verified_at|date('Y-m-d H:i:s') }}</span>
                  {% else %}
                    <span class="text-muted">{{ 'mautic.whatsapp.config.webhook.never'|trans }}</span>
                  {% endif %}
                </td>
              </tr>
              <tr>
                <td class="text-muted">{{ 'mautic.whatsapp.config.webhook.last_received'|trans }}</td>
                <td>
                  {% if webhookState.last_received_at %}
                    <span class="text-success"><i class="ri-check-line"></i> {{ webhookState.last_received_at|date('Y-m-d H:i:s') }}</span>
                  {% else %}
                    <span class="text-muted">{{ 'mautic.whatsapp.config.webhook.never'|trans }}</span>
                  {% endif %}
                </td>
              </tr>
              <tr>
                <td class="text-muted">{{ 'mautic.whatsapp.config.webhook.receive_count'|trans }}</td>
                <td>{{ webhookState.receive_count }}</td>
              </tr>
              {% if webhookState.last_error %}
              <tr>
                <td class="text-muted">{{ 'mautic.whatsapp.config.webhook.last_error'|trans }}</td>
                <td>
                  <span class="text-danger"><i class="ri-alert-line"></i> {{ webhookState.last_error }}</span>
                  {% if webhookState.last_error_at %}
                    <br><small class="text-muted">{{ webhookState.last_error_at|date('Y-m-d H:i:s') }}</small>
                  {% endif %}
                </td>
              </tr>
              {% endif %}
            </tbody>
          </table>
        </div>
      </div>

      <hr>

      <div class="text-center">
        <button type="button" id="whatsapp-test-webhook-btn" class="btn btn-primary"
                onclick="Mautic.whatsappTestWebhook()">
          <i class="ri-plug-line"></i> {{ 'mautic.whatsapp.config.webhook.test'|trans }}
        </button>
        <div id="whatsapp-test-webhook-result" style="margin-top:15px;"></div>
      </div>

      <p class="text-muted small" style="margin-top:15px;">
        <i class="ri-external-link-line"></i>
        {{ 'mautic.whatsapp.config.webhook.configure_hint'|trans|raw }}
      </p>
      <p class="text-muted small">
        {{ 'mautic.whatsapp.config.webhook.subscribe_hint'|trans|raw }}
      </p>
    </div>
  </div>
</div>
{% endblock %}
