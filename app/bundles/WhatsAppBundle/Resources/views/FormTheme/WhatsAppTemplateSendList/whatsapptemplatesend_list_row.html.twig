{% block _whatsapp_template_send_list_row %}
<div class="row">
    <div class="col-xs-8">
        {{ form_row(form.whatsapp) }}
    </div>
    <div class="col-xs-4 mt-lg">
        <div class="mt-3">
            {% if form.newWhatsAppTemplateButton is defined %}
                {{ form_row(form.newWhatsAppTemplateButton) }}
            {% endif %}
            {% if form.editWhatsAppTemplateButton is defined %}
                {{ form_row(form.editWhatsAppTemplateButton) }}
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}
